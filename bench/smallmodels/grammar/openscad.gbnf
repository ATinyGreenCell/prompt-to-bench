fname-24 ::= ( "o" fname-23 | [0-9A-Z_a-np-z] id-tail )?
fname-23 ::= ( "r" fname-0 | [0-9A-Z_a-qs-z] id-tail )?
fname-22 ::= ( "r" fname-21 | [0-9A-Z_a-qs-z] id-tail )?
fname-21 ::= ( "c" fname-20 | [0-9A-Z_abd-z] id-tail )?
fname-20 ::= ( "l" fname-1 | [0-9A-Z_a-km-z] id-tail )?
fname-19 ::= ( "i" fname-18 | [0-9A-Z_a-hj-z] id-tail )?
fname-18 ::= ( "l" fname-17 | [0-9A-Z_a-km-z] id-tail )?
fname-17 ::= ( "d" fname-16 | [0-9A-Z_a-ce-z] id-tail )?
fname-16 ::= ( "r" fname-15 | [0-9A-Z_a-qs-z] id-tail )?
fname-15 ::= ( "e" fname-14 | [0-9A-Z_a-df-z] id-tail )?
fname-14 ::= ( "n" fname-0 | [0-9A-Z_a-mo-z] id-tail )?
fname-13 ::= ( "s" fname-12 | [0-9A-Z_a-rt-z] id-tail )?
fname-12 ::= ( "s" fname-11 | [0-9A-Z_a-rt-z] id-tail )?
fname-11 ::= ( "e" fname-10 | [0-9A-Z_a-df-z] id-tail )?
fname-10 ::= ( "r" fname-9 | [0-9A-Z_a-qs-z] id-tail )?
fname-9 ::= ( "t" fname-0 | [0-9A-Z_a-su-z] id-tail )?
fname-8 ::= ( "r" fname-7 | [0-9A-Z_a-qs-z] id-tail )?
fname-7 ::= ( "u" fname-1 | [0-9A-Z_a-tv-z] id-tail )?
fname-6 ::= ( "o" fname-5 | [0-9A-Z_a-np-z] id-tail )?
fname-5 ::= ( "n" fname-1 | [0-9A-Z_a-mo-z] id-tail )?
fname-4 ::= ( "a" fname-3 | [0-9A-Z_b-z] id-tail )?
fname-3 ::= ( "l" fname-2 | [0-9A-Z_a-km-z] id-tail )?
fname-2 ::= ( "s" fname-1 | [0-9A-Z_a-rt-z] id-tail )?
fname-1 ::= ( "e" fname-0 | [0-9A-Z_a-df-z] id-tail )?
fname-0 ::= [0-9A-Z_a-z] id-tail
id-tail ::= [a-zA-Z0-9_]{0,48}

# ws: optional whitespace and comments between two tokens. Every token is followed by ws, so ws
# never meets ws; space runs never follow each other; at most 5 newlines in a row.
ws ::= ( sp ws-b0 | nl ws-a1 | lcom ws-a1 | bcom ws )?
ws-b0 ::= ( nl ws-a1 | lcom ws-a1 | bcom ws )?
ws-a1 ::= ( sp ws-b1 | nl ws-a2 | lcom ws-a1 | bcom ws )?
ws-b1 ::= ( nl ws-a2 | lcom ws-a1 | bcom ws )?
ws-a2 ::= ( sp ws-b2 | nl ws-a3 | lcom ws-a1 | bcom ws )?
ws-b2 ::= ( nl ws-a3 | lcom ws-a1 | bcom ws )?
ws-a3 ::= ( sp ws-b3 | nl ws-a4 | lcom ws-a1 | bcom ws )?
ws-b3 ::= ( nl ws-a4 | lcom ws-a1 | bcom ws )?
ws-a4 ::= ( sp ws-b4 | nl ws-a5 | lcom ws-a1 | bcom ws )?
ws-b4 ::= ( nl ws-a5 | lcom ws-a1 | bcom ws )?
ws-a5 ::= ( sp ws-b5 | lcom ws-a1 | bcom ws )?
ws-b5 ::= ( lcom ws-a1 | bcom ws )?
# ws1: whitespace that is not empty (after keywords followed by a name)
ws1 ::= sp ws-b0 | nl ws-a1 | lcom ws-a1 | bcom ws

sp ::= [ \t]{1,96}
nl ::= "\r"? "\n"
# a line comment runs to its newline; a backtick is never followed by another one
lcom ::= "//" lcom-char{0,400} "`"? "\n"
lcom-char ::= [^\n`] | "`" [^\n`]
bcom ::= "/*" bcom-char{0,1500} "*"{1,80} "/"
bcom-char ::= [^*`] | "`" [^*`] | "*"{1,80} [^*/`]
