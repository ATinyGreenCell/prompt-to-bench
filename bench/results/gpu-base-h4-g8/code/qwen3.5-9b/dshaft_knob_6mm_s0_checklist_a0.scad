$fn = 128;

// Calculate D-bore geometry
// The D-bore is a circle of diameter d_bore with one side cut flat.
// The distance from the flat to the opposite arc is d_flat.
// Let r_b = d_bore / 2.
// The cut removes a segment of the circle.
// The depth of the cut (from the chord to the arc) is r_b - d_flat/2.
// The width of the flat face is 2 * sqrt(r_b^2 - (r_b - d_flat/2)^2).

r_b = d_bore / 2;
cut_depth = r_b - d_flat / 2;
